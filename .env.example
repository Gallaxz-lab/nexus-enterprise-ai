# Server Deployment
ENVIRONMENT=development
SECRET_KEY=super-secret-jwt-signing-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relational Database
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nexus_db

# Object Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=nexus;...

# AI Provider Configurations
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...